# Copy this file to .env and paste your key. Never commit .env.
#
# LaunchDarkly > Project settings > Environments > (your env) > SDK keys
# Use the SERVER-SIDE SDK key (starts with "sdk-"), NOT the client-side ID or mobile key.
LD_SDK_KEY=sdk-REPLACE-ME

# Optional. macOS AirPlay Receiver often occupies 5000; use 5001 if so.
PORT=5000
